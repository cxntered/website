---
import { Icon } from "astro-icon/components";

const { icon, href, text, isColored = true } = Astro.props;

const COLORS: Record<string, string> = {
	discord: "#5865f2",
	github: "white",
	codeberg: "#2185d0",
	modrinth: "#00af5c",
	twitter: "#1d9bf0",
	bluesky: "#1185fe",
	youtube: "red",
	twitch: "#9146ff",
	namemc: "white",
	tetrio: "#df4eaa",
	monkeytype: "#e2b714",
	world: "var(--color-ctp-blue)",
};

const iconName = icon.split(":").at(-1);
const color = COLORS[iconName];
---

<a
	href={href}
	class:list={[
		"flex flex-row items-center gap-2 rounded-md px-2 py-1 transition-colors",
		isColored
			? "colored-link-button text-ctp-text"
			: "bg-ctp-subtext0 hover:bg-ctp-text focus-visible:bg-ctp-text text-ctp-crust",
	]}
	target="_blank"
	rel="noopener noreferrer"
>
	<Icon name={icon} size="24" class={isColored ? "colored-icon" : "text-ctp-crust"} />
	<span class="text-md">{text}</span>
</a>

<style define:vars={{ color }}>
	.colored-link-button {
		background: linear-gradient(to bottom, transparent, --alpha(var(--color) / 10%));
		border: 1px solid --alpha(var(--color) / 50%);

		&:hover,
		&:focus-visible {
			background: linear-gradient(to bottom, transparent, --alpha(var(--color) / 25%));
			border-color: var(--color);
		}
	}

	.colored-icon {
		color: var(--color);
	}
</style>
