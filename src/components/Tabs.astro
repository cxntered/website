---
interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;

const tabs = [
	{ path: "/", label: "home" },
	{ path: "/about", label: "about" },
	{ path: "/socials", label: "socials" },
	{ path: "/projects", label: "projects" },
];

const normalizePath = (path: string) => path.replace(/(?:\/index)?\.html$|\/+$/, "") || "/";

const isActive = (path: string) => {
	const normalizedCurrentPath = normalizePath(currentPath);
	const normalizedPath = normalizePath(path);

	if (normalizedPath === "/") {
		return normalizedCurrentPath === "/";
	}

	return normalizedCurrentPath === normalizedPath || normalizedCurrentPath.startsWith(`${normalizedPath}/`);
};
---

<nav class="flex flex-row gap-4">
	{
		tabs.map(({ path, label }) => (
			<a
				href={path}
				aria-current={isActive(path) ? "page" : undefined}
				class={`transition-colors ${
					isActive(path)
						? "text-ctp-mauve"
						: "text-ctp-subtext0 hover:text-ctp-text focus-visible:text-ctp-text"
				}`}
			>
				{label}
			</a>
		))
	}
</nav>
