---
import SkillBadge from "../components/SkillBadge.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Twemoji from "../components/Twemoji.astro";

const SKILLS = [
	{ name: "javascript", icon: "catppuccin:javascript", color: "var(--color-ctp-yellow)" },
	{ name: "typescript", icon: "catppuccin:typescript", color: "var(--color-ctp-blue)" },
	{ name: "java", icon: "catppuccin:java", color: "var(--color-ctp-red)" },
	{ name: "kotlin", icon: "catppuccin:kotlin", color: "var(--color-ctp-lavender)" },
	{ name: "python", icon: "catppuccin:python", color: "var(--color-ctp-blue)" },
	{ name: "go", icon: "catppuccin:go", color: "var(--color-ctp-sapphire)" },
	{ name: "react", icon: "catppuccin:javascript-react", color: "var(--color-ctp-sky)" },
	{ name: "astro", icon: "catppuccin:astro", color: "var(--color-ctp-pink)" },
	{ name: "tailwind", icon: "catppuccin:tailwind", color: "var(--color-ctp-sapphire)" },
	{ name: "html", icon: "catppuccin:html", color: "var(--color-ctp-peach)" },
	{ name: "css", icon: "catppuccin:css", color: "var(--color-ctp-mauve)" },
	{ name: "git", icon: "catppuccin:git", color: "var(--color-ctp-flamingo)" },
	{ name: "figma", icon: "catppuccin:figma", color: "var(--color-ctp-lavender)" },
];

const OSHI_MARKS = ["🐾", "👧", "🍵", "🗿", "⏳", "💜"];
---

<BaseLayout title="about me" description="learn more about cxntered ( ´ ω ` )">
	<div class="text-ctp-text flex flex-col gap-2.5 leading-relaxed">
		<p class="text-lg font-semibold">
			hey there, i'm <span id="cxntered">cxntered</span>!! <Twemoji emoji="👋" />
		</p>
		<p>i'm a self-taught full-stack developer who picked up programming for fun back in 2020.</p>
		<p>
			i originally started with bots in discord.js, but have since learnt a variety of different programming
			languages (which you can see below!!)
		</p>
		<p>i've also personally adminned/modded/developed for various decently sized content creators! :o</p>
		<p>
			outside of programming, i enjoy playing games across lots of genres, including shooters, action, adventure,
			rpgs, sandbox, rhythm, and more.
		</p>
	</div>
	<div class="flex flex-col gap-2">
		<h2 class="subheading">skills</h2>
		<div class="flex flex-row flex-wrap gap-2">
			{SKILLS.map(({ name, icon, color }) => <SkillBadge icon={icon} text={name} color={color} />)}
		</div>
	</div>
	<div class="flex flex-col gap-2">
		<!-- oshi marks :3 -->
		<h2 class="subheading">"emojis"</h2>
		<p class="text-ctp-text text-2xl">
			{OSHI_MARKS.map((emoji) => <Twemoji emoji={emoji} />)}
		</p>
	</div>
</BaseLayout>
